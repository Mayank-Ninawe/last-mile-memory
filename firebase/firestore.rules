rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read, update, delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow create: if signedIn()
        && get(
          /databases/$(database)/documents/households/$(request.resource.data.householdId)
        ).data.ownerId == request.auth.uid;

      allow read, update, delete: if signedIn()
        && get(
          /databases/$(database)/documents/households/$(resource.data.householdId)
        ).data.ownerId == request.auth.uid;
    }

    match /emergencySessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.activatedByUserId == request.auth.uid;

      allow read, update: if signedIn();

      allow delete: if false;
    }

    match /delegates/{delegateId} {
      allow create, read: if signedIn();

      allow update, delete: if false;
    }
  }
}